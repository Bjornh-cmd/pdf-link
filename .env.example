# Kopieer naar .env en vul in (optioneel voor Docker; defaults in compose)
HOST_PORT=3000
RESEND_API_KEY=
# Productie (domein moet geverifieerd zijn in Resend → Domains):
EMAIL_FROM=pdf@support.snubstad.nl
# Tijdelijk testen zonder eigen domein (alleen naar je Resend-account e-mail):
# EMAIL_FROM=onboarding@resend.dev
ALLOWED_UPLOAD_EMAIL=bjornhoutman14@gmail.com
SESSION_SECRET=vervang-met-lange-random-string

# Lokaal
BASE_URL=http://localhost:3000

# Coolify / productie (pdf.bjorn-sites.nl)
# BASE_URL=https://pdf.bjorn-sites.nl
# COOKIE_SECURE=true
# RP_ID=pdf.bjorn-sites.nl
# RP_NAME=PDF Link

MAX_FILE_SIZE_MB=25

# Optioneel: komma-gescheiden extensies (default o.a. pdf, stl, png, zip)
# ALLOWED_EXTENSIONS=pdf,stl,png,jpg,zip,txt

# Coolify: alleen volume /data/uploads — DATA_DIR hoeft niet gezet (default: /data/uploads/.app)
# UPLOAD_DIR=/data/uploads
